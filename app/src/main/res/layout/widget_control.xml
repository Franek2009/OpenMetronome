<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_panel">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="12sp" android:textColor="#E0E2DB" android:maxLines="1"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
      <TextView android:id="@+id/widget_bpm" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="@string/widget_label_1" android:textSize="32sp" android:textColor="#E0E2DB" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="36sp"/>
      <TextView android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:id="@+id/widget_base" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_label_4" android:textSize="12sp" android:textColor="#E0E2DB"/>
    </LinearLayout>
    <LinearLayout android:layout_width="110dp" android:layout_height="wrap_content" android:orientation="vertical">
      <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_play" android:layout_width="match_parent" android:layout_height="48dp" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_3" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
    </LinearLayout>
  </LinearLayout>
  <TextView android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_label_2" android:textSize="12sp" android:textColor="#E0E2DB"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
    <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_100" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_5" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
    <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_75" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_6" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
    <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_50" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_7" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
    <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_25" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_8" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
  </LinearLayout>
  <LinearLayout android:visibility="gone" android:id="@+id/widget_steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
    <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_minus" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_9" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
    <Button android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:maxLines="1" android:textAllCaps="false" android:id="@+id/widget_plus" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:layout_margin="2dp" android:text="@string/widget_label_10" android:textSize="14sp" android:textColor="#102B1B" android:background="@drawable/widget_selected"/>
  </LinearLayout>
</LinearLayout>
